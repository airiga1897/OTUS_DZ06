ETCD_NAME="{{ inventory_hostname }}"
ETCD_DATA_DIR="{{ stack.etcd.data_dir }}"
ETCD_LISTEN_PEER_URLS="http://{{ ansible_host }}:{{ stack.etcd.peer_port }}"
ETCD_LISTEN_CLIENT_URLS="http://{{ ansible_host }}:{{ stack.etcd.client_port }},http://127.0.0.1:{{ stack.etcd.client_port }}"
ETCD_INITIAL_ADVERTISE_PEER_URLS="http://{{ ansible_host }}:{{ stack.etcd.peer_port }}"
ETCD_ADVERTISE_CLIENT_URLS="http://{{ ansible_host }}:{{ stack.etcd.client_port }}"
ETCD_INITIAL_CLUSTER="{% for name in groups['etcd_voters'] %}{{ name }}=http://{{ hostvars[name].ansible_host }}:{{ stack.etcd.peer_port }}{% if not loop.last %},{% endif %}{% endfor %}"
ETCD_INITIAL_CLUSTER_TOKEN="{{ stack.etcd.token }}"
ETCD_INITIAL_CLUSTER_STATE="new"
