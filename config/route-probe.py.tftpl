import hashlib
import hmac
from http.server import BaseHTTPRequestHandler, HTTPServer
import json
from urllib.parse import urlsplit, parse_qs

KEY = '${probe_key}'.encode()


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        nonce = parse_qs(urlsplit(self.path).query).get('nonce', [''])[0]
        if not nonce or len(nonce) > 128:
            self.send_error(400)
            return
        address = self.client_address[0]
        signature = hmac.new(KEY, (nonce + '|' + address).encode(), hashlib.sha256).hexdigest()
        body = json.dumps({'nonce': nonce, 'ip': address, 'signature': signature}).encode()
        self.send_response(200)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Cache-Control', 'no-store')
        self.send_header('Content-Length', str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args):
        pass


HTTPServer(('0.0.0.0', 80), Handler).serve_forever()
